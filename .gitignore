# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
build/
dist/
*.egg-info/

# Unit test / coverage reports
.pytest_cache/
.coverage
.coverage.*
htmlcov/

# Environments
.env
.venv
env/
venv/

# Personal app data: saved matches, local profile (player tag). Never commit.
user_data/

# macOS files
.DS_Store
.AppleDouble
.LSOverride
._*

# Editor / IDE configs
.vscode/
.idea/
*.swp
*.swo

# Large pretrained weights (downloadable via pretrained_weights/download_weights.py)
pretrained_weights/*.pt
pretrained_weights/*.onnx
pretrained_weights/*.pth
!pretrained_weights/README.md
!pretrained_weights/download_weights.py


# Detector weights (licence: personal use only, do not redistribute)
pretrained_weights/**/*.onnx

# Detector training weights (same licence)
pretrained_weights/**/*.pt
pretrained_weights/**/*.pth
recordings/

# Fine-tuning sets built from the user's own recordings (private gameplay)
data/finetune/

# Lint cache
.ruff_cache/

# Mode B / fine-tune artifacts (private gameplay, large)
*.mov
*.mp4
data/**/*.zip
*_reviewed/
runs/
detector_ipad_ft*.zip
